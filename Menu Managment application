import React, { useMemo, useState } from 'react';
import {
  Alert,
  Image,
  Modal,
  Pressable,
  SafeAreaView,
  ScrollView,
  StatusBar,
  StyleSheet,
  Text,
  TextInput,
  View,
} from 'react-native';

const seedMenu = [
  { id: '1', course: 'Starters', name: 'Burrata Bruschetta', price: '78.00', ingredients: 'Burrata, tomato, basil, sourdough', description: 'Grilled sourdough topped with creamy burrata, roasted cherry tomatoes and fresh basil.', image: 'https://images.unsplash.com/photo-1572695157366-5e585ab2b69f?auto=format&fit=crop&w=700&q=80' },
  { id: '2', course: 'Main', name: 'Margherita Pizza', price: '90.00', ingredients: 'Mozzarella, tomato, basil, olive oil', description: 'A classic wood-fired pizza with a light, blistered crust, San Marzano tomato and creamy mozzarella.', image: 'https://images.unsplash.com/photo-1574071318508-1cdbab80d002?auto=format&fit=crop&w=700&q=80' },
  { id: '3', course: 'Main', name: 'BBQ Chicken Pizza', price: '120.00', ingredients: 'Chicken, mozzarella, BBQ sauce, coriander', description: 'Tangy BBQ chicken, smoked mozzarella and fresh coriander on our signature hand-stretched base.', image: 'https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=700&q=80' },
  { id: '4', course: 'Desserts', name: 'Tiramisu', price: '68.00', ingredients: 'Mascarpone, espresso, cocoa, ladyfingers', description: 'Silky mascarpone layers with espresso-soaked ladyfingers and a generous dusting of cocoa.', image: 'https://images.unsplash.com/photo-1571877227200-a0d98ea607e9?auto=format&fit=crop&w=700&q=80' },
  { id: '5', course: 'Drinks', name: 'Berry Sparkler', price: '45.00', ingredients: 'Berries, lemon, soda, mint', description: 'A bright, refreshing house soda with muddled berries, lemon and mint.', image: 'https://images.unsplash.com/photo-1551024709-8f23befc6f87?auto=format&fit=crop&w=700&q=80' },
];

const courses = ['Starters', 'Main', 'Desserts', 'Drinks'];
const emptyDish = { course: 'Starters', name: '', price: '', ingredients: '', description: '', image: '' };

export default function App() {
  const [signedIn, setSignedIn] = useState(false);
  const [menu, setMenu] = useState(seedMenu);
  const [course, setCourse] = useState('Main');
  const [search, setSearch] = useState('');
  const [editing, setEditing] = useState(null);
  const [editorOpen, setEditorOpen] = useState(false);
  const [form, setForm] = useState(emptyDish);
  const [preview, setPreview] = useState(null);

  const dishes = useMemo(() => menu.filter((dish) => dish.course === course && dish.name.toLowerCase().includes(search.toLowerCase())), [menu, course, search]);
  const openNew = () => { setEditing(null); setForm({ ...emptyDish, course }); setEditorOpen(true); };
  const openEdit = (dish) => { setEditing(dish); setForm({ ...dish }); setEditorOpen(true); };
  const saveDish = () => {
    if (!form.name.trim() || !form.price.trim()) return Alert.alert('Add a name and price', 'These details are needed to save a menu item.');
    const complete = { ...form, id: editing?.id || Date.now().toString(), image: form.image || seedMenu[1].image };
    setMenu((items) => editing ? items.map((item) => item.id === editing.id ? complete : item) : [complete, ...items]);
    setCourse(complete.course); setEditing(null); setForm(emptyDish); setEditorOpen(false);
  };
  const removeDish = () => Alert.alert('Remove menu item?', `Remove ${editing.name} from the menu?`, [
    { text: 'Cancel', style: 'cancel' },
    { text: 'Remove', style: 'destructive', onPress: () => { setMenu((items) => items.filter((item) => item.id !== editing.id)); setEditing(null); setEditorOpen(false); } },
  ]);

  if (!signedIn) return <Login onLogin={() => setSignedIn(true)} />;

  return <SafeAreaView style={styles.safe}>
    <StatusBar barStyle="dark-content" />
    <View style={styles.app}>
      <View style={styles.topNav}><Pressable onPress={() => setSignedIn(false)}><Text style={styles.navText}>LOGOUT</Text></Pressable><Text style={styles.navText}>HOME MENU</Text><Text style={styles.navText}>OPTIONS</Text></View>
      <View style={styles.titleRow}><Text style={styles.title}>Menu</Text><View style={styles.search}><Text style={styles.searchIcon}>⌕</Text><TextInput value={search} onChangeText={setSearch} placeholder="SEARCH" placeholderTextColor="#333" style={styles.searchInput} /></View></View>
      <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={styles.content}>
        <View style={styles.hero}><Text style={styles.heroEyebrow}>CHEF'S TABLE</Text><Text style={styles.heroTitle}>MENU COURSE</Text><View style={styles.courseBox}><Text style={styles.courseHeading}>Menu Course</Text>{courses.map((item) => <Pressable key={item} onPress={() => setCourse(item)} style={[styles.courseButton, course === item && styles.courseSelected]}><Text style={styles.courseText}>{item}</Text></Pressable>)}</View></View>
        <View style={styles.listHeader}><Text style={styles.listTitle}>{course} menu</Text><Pressable onPress={openNew} style={styles.addButton}><Text style={styles.addText}>+ ADD ITEM</Text></Pressable></View>
        {dishes.map((dish) => <DishCard key={dish.id} dish={dish} onPress={() => setPreview(dish)} onEdit={() => openEdit(dish)} />)}
        {!dishes.length && <View style={styles.empty}><Text style={styles.emptyTitle}>No {course.toLowerCase()} yet</Text><Text style={styles.emptyText}>Add your first menu item to begin customizing this course.</Text></View>}
        <Pressable style={styles.previewButton} onPress={() => setPreview(dishes[0] || null)}><Text style={styles.previewText}>MENU ITEM PREVIEW</Text></Pressable>
      </ScrollView>
    </View>
    <Editor visible={editorOpen} form={form} setForm={setForm} onClose={() => { setEditing(null); setForm(emptyDish); setEditorOpen(false); }} onSave={saveDish} onDelete={editing ? removeDish : null} />
    <Preview dish={preview} onClose={() => setPreview(null)} onEdit={() => { setPreview(null); openEdit(preview); }} />
  </SafeAreaView>;
}

function Login({ onLogin }) { const [email, setEmail] = useState('chef@cristobal.co.za'); const [password, setPassword] = useState(''); return <SafeAreaView style={styles.loginSafe}><View style={styles.login}><Text style={styles.brand}>Cristobal</Text><Text style={styles.loginTitle}>Chef Menu Studio</Text><Text style={styles.loginCopy}>Create, edit and preview your restaurant menu in one place.</Text><Text style={styles.label}>EMAIL ADDRESS</Text><TextInput style={styles.loginInput} value={email} onChangeText={setEmail} autoCapitalize="none" keyboardType="email-address" /><Text style={styles.label}>PASSWORD</Text><TextInput style={styles.loginInput} value={password} onChangeText={setPassword} secureTextEntry placeholder="Enter your password" /><Pressable onPress={onLogin} style={styles.loginButton}><Text style={styles.loginButtonText}>SIGN IN</Text></Pressable><Text style={styles.loginHint}>Demo mode: enter any password to continue</Text></View></SafeAreaView> }
function DishCard({ dish, onPress, onEdit }) { return <Pressable onPress={onPress} style={styles.dishCard}><View style={styles.cardTag}><Text style={styles.cardTagText}>Menu item</Text></View><Image source={{ uri: dish.image }} style={styles.dishImage} /><View style={styles.dishContent}><Text style={styles.dishName}>{dish.name}</Text><Text numberOfLines={4} style={styles.dishDescription}>{dish.description}</Text><Text numberOfLines={2} style={styles.ingredients}><Text style={styles.ingredientsBold}>Ingredients: </Text>{dish.ingredients}</Text><Text style={styles.price}>R {dish.price}</Text><Pressable onPress={onEdit} style={styles.editPill}><Text style={styles.editPillText}>EDIT ITEM</Text></Pressable></View></Pressable> }
function Field({ label, value, onChangeText, multiline, placeholder, keyboardType }) { return <><Text style={styles.formLabel}>{label}</Text><TextInput style={[styles.formInput, multiline && styles.textarea]} value={value} onChangeText={onChangeText} multiline={multiline} placeholder={placeholder} keyboardType={keyboardType} /></> }
function Editor({ visible, form, setForm, onClose, onSave, onDelete }) { return <Modal visible={visible} animationType="slide" onRequestClose={onClose}><SafeAreaView style={styles.modalSafe}><View style={styles.modalHeader}><Pressable onPress={onClose}><Text style={styles.close}>CANCEL</Text></Pressable><Text style={styles.modalTitle}>{onDelete ? 'Edit menu item' : 'Add menu item'}</Text><Pressable onPress={onSave}><Text style={styles.save}>SAVE</Text></Pressable></View><ScrollView contentContainerStyle={styles.form}><Text style={styles.formIntro}>Make it appetizing. Every detail below appears in your menu preview.</Text><Text style={styles.formLabel}>COURSE</Text><View style={styles.choiceRow}>{courses.map((course) => <Pressable key={course} onPress={() => setForm({ ...form, course })} style={[styles.choice, form.course === course && styles.choiceActive]}><Text style={[styles.choiceText, form.course === course && styles.choiceTextActive]}>{course}</Text></Pressable>)}</View><Field label="DISH NAME" value={form.name} onChangeText={(name) => setForm({ ...form, name })} placeholder="e.g. Margherita Pizza" /><Field label="PRICE (R)" value={form.price} onChangeText={(price) => setForm({ ...form, price })} keyboardType="decimal-pad" placeholder="90.00" /><Field label="INGREDIENTS" value={form.ingredients} onChangeText={(ingredients) => setForm({ ...form, ingredients })} multiline placeholder="Separate ingredients with commas" /><Field label="DISH DESCRIPTION" value={form.description} onChangeText={(description) => setForm({ ...form, description })} multiline placeholder="Tell diners about the dish" /><Field label="PHOTO URL" value={form.image} onChangeText={(image) => setForm({ ...form, image })} placeholder="https://..." />{onDelete && <Pressable onPress={onDelete} style={styles.deleteButton}><Text style={styles.deleteText}>REMOVE MENU ITEM</Text></Pressable>}</ScrollView></SafeAreaView></Modal> }
function Preview({ dish, onClose, onEdit }) { return <Modal visible={!!dish} animationType="fade" transparent onRequestClose={onClose}>{dish && <View style={styles.previewOverlay}><View style={styles.previewSheet}><Image source={{ uri: dish.image }} style={styles.previewImage} /><View style={styles.previewBody}><Text style={styles.previewCourse}>{dish.course.toUpperCase()}</Text><Text style={styles.previewName}>{dish.name}</Text><Text style={styles.previewPrice}>R {dish.price}</Text><Text style={styles.previewDescription}>{dish.description}</Text><Text style={styles.previewIngredients}><Text style={styles.ingredientsBold}>Ingredients: </Text>{dish.ingredients}</Text><View style={styles.previewActions}><Pressable onPress={onClose} style={styles.secondaryButton}><Text style={styles.secondaryText}>CLOSE</Text></Pressable><Pressable onPress={onEdit} style={styles.primaryButton}><Text style={styles.primaryText}>EDIT ITEM</Text></Pressable></View></View></View></View>}</Modal> }

